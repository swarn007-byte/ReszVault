FRONTEND_ORIGIN=http://localhost:5175
BACKEND_PUBLIC_URL=http://localhost:3000
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Google OAuth provider.
# Add this redirect URI in Google Console for local development:
# http://localhost:3000/api/auth/google/callback
# Production should use:
# https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Credentials for a GitHub App with read-only Metadata, Pull requests, and Issues.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_CALLBACK_ORIGIN=http://localhost:5173

# Optional repository RAG settings.
# Put the data directory on persistent storage in production when available.
# RESZVAULT_DATA_DIR=/var/data
# REPOSITORY_LOCAL_EMBEDDINGS=true
# GITHUB_WEBHOOK_SECRET=

# Optional SWE-QA sliding-window backend for public repo code questions.
# REPOSITORY_RAG_MODE=swe-qa
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-code-3
# SWE_QA_ANSWER_API_KEY=
# SWE_QA_ANSWER_MODEL=gpt-5.1
# SWE_QA_ANSWER_URL=https://api.openai.com/v1/chat/completions
