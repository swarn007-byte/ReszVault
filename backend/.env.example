DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
FRONTEND_ORIGIN=http://localhost:5175
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
# DATABASE_URL overrides the local PostgreSQL options when set.
# DATABASE_URL=postgresql://user:password@host:5432/database
RESZVAULT_DB_NAME=reszvault
RESZVAULT_DB_USER=reszvault
RESZVAULT_DB_PASSWORD=reszvault-demo
RESZVAULT_DB_PORT=55432

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# RESZVAULT_LOCAL_EMBEDDINGS=0

# Register http://localhost:5175/api/auth/google/callback with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Configure the GitHub App callback to match this frontend origin.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_CALLBACK_ORIGIN=http://localhost:5175
# GITHUB_WEBHOOK_SECRET=
# REPOSITORY_LOCAL_EMBEDDINGS=1

